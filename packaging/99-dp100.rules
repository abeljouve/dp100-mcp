# ALIENTEK DP100 (USB "ATK-MDP100", 2e3c:af01) in USBD mode.
# Gives the hidraw node to group plugdev (no root needed) and to the
# logged-in seat user via uaccess.
#   sudo install -m 0644 packaging/99-dp100.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   sudo usermod -aG plugdev "$USER"   # then log out / in
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2e3c", ATTRS{idProduct}=="af01", MODE="0660", GROUP="plugdev", TAG+="uaccess"
